# Copy this file to ~/.chiplog/.env, not into the repository:
#
#   install -d -m 700 ~/.chiplog
#   install -m 600 .env.example ~/.chiplog/.env
#
# Replace placeholders locally. Never commit secret values.

# Local public Telegram bot. Polling needs no VPS, public URL or webhook.
CHIPLOG_TELEGRAM_BOT_TOKEN=
CHIPLOG_INGRESS_MODE=polling

# Public-access guard. Empty invite keys must fail closed.
CHIPLOG_INVITE_KEYS=
CHIPLOG_WAITLIST_CONTACT=@chiplog_beta
CHIPLOG_MAX_TURNS_PER_MINUTE=10

# Google OAuth. The public callback reaches this local process through the existing VPS
# and a reverse SSH tunnel; Chiplog itself is not deployed there.
CHIPLOG_GOOGLE_WEB_CLIENT_JSON_PATH=/Users/thunderbird/.chiplog/credentials/google-web-client.json
CHIPLOG_GOOGLE_REDIRECT_URI=https://chiplog.forbiddenfundamentals.com/oauth/google/callback

# Default timezone until per-user profiles exist.
CHIPLOG_TIMEZONE=Asia/Almaty
