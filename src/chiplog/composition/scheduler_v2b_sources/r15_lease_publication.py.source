_POLICY_OPERATION: Literal["r15.adopt_lease_execution_policy"] = "r15.adopt_lease_execution_policy"
_POLICY_SCHEMA = "chiplog.r15.lease-policy-adoption.v1"
_EVIDENCE_SCHEMA = "chiplog.r15.lease-publication-evidence.v1"
_EXECUTION_SESSION = "r15-hermetic-execution-session-v1"
_ADMIN_POLICY_BYTES = _canonical(
    {
        "schema": "chiplog.r15.lease-admin-policy.v1",
        "tenant": "hermetic-tenant",
        "principal": "hermetic-principal",
        "operation": _POLICY_OPERATION,
        "service": EXECUTION_SERVICE,
        "session": _EXECUTION_SESSION,
        "max_lease_ns": 60_000_000_000,
        "authentication_budget_ns": 30_000_000_000,
    }
)


@dataclass(frozen=True, eq=False)
class LeaseExecutionSession:
    """Opaque current-runtime capability; construction grants no authority."""

    service_identity: str
    session_id: str
    policy: Present
    broker_epoch: int
    generation: str


def _cut(sources: SchedulerFreshSources) -> TickSourceCut:
    cut = sources.startup.cut
    if cut.independent_journal_head is None:
        raise LoopRejected("lease source requires selected journal history")
    return TickSourceCut(
        tenant_id=cut.tenant_id,
        database_id=f"{cut.physical_database_path}:{cut.physical_device}:{cut.physical_inode}",
        database_path=cut.physical_database_path,
        database_device=cut.physical_device,
        database_inode=cut.physical_inode,
        tenant_frontier=cut.tenant_frontier,
        materialization_commitment=cut.materialization_commitment,
        independent_journal_head=cut.independent_journal_head,
        deletion_fence_generation=sources.fence_generation,
        deletion_fence_frontier=sources.fence_frontier,
    )


def _mandate(
    sources: SchedulerFreshSources, reference: Present | None = None
) -> SelectedScheduledSystemMandateV2:
    candidates = [
        item
        for item in sources.startup.index.mandates
        if reference is None or item.mandate_head == reference
    ]
    if len(candidates) != 1:
        raise LoopRejected("lease requires one exact selected mandate")
    item = candidates[0]
    # The index admits only immutable issuance pairs; a future revocation mapper
    # must explicitly replace this closed no-revocation profile.
    selected = next(
        original.selection
        for original in sources.startup.cut.historical_requests
        if any(
            row.record_id == item.mandate_head.head
            for row in original.selection.prepared.request.complete_records
        )
    )
    return SelectedScheduledSystemMandateV2(
        mandate_head=item.mandate_head,
        canonical_mandate_bytes=item.mandate.canonical_bytes(),
        mandate=item.mandate,
        issuance_observation=CallSubjectHead(
            subject_id="r15-mandate-issuance",
            revision=Present(
                head=selected.decision_head, fingerprint=selected.decision_fingerprint
            ),
        ),
    )


def _validate_root_frames(
    frames: tuple[bytes, ...],
    current: SchedulerLineageView,
    mandate: SelectedScheduledSystemMandateV2,
) -> None:
    matches = []
    for raw in frames:
        batch = SingleOwnerBatch.model_validate_json(raw)
        if (
            _canonical(batch.model_dump(mode="json")) != raw
            or batch.operation != "scheduler.decide_interval"
        ):
            raise LoopRejected("lease root source is not canonical selected tick")
        for row in batch.complete_records:
            if row.record_kind == "batch-primitive":
                primitive = ScheduledBatchPrimitiveDomainV1.model_validate_json(row.canonical_bytes)
                if primitive.root_id == current.lineage.root_id:
                    matches.append(primitive)
    if len(matches) != 1:
        raise LoopRejected("lease root primitive provenance differs")
    primitive = matches[0]
    scope = mandate.mandate.scope
    schedule, missed = (
        primitive.boundary.schedule_definition_head,
        primitive.boundary.missed_occurrence_policy_head,
    )
    coordinates = [
        member.due_coordinate
        for member in primitive.manifest.members
        if primitive.subject.kind == "COALESCED"
        or member.occurrence_id == primitive.subject.occurrence_id
    ]
    if (
        primitive.subject != current.lineage.subject
        or primitive.initial_run_id != current.lineage.initial_run_id
        or (schedule.head, schedule.fingerprint)
        != (scope.schedule_head.revision.head, scope.schedule_head.revision.fingerprint)
        or (missed.head, missed.fingerprint)
        != (scope.missed_policy_head.revision.head, scope.missed_policy_head.revision.fingerprint)
        or (primitive.bound_head.head_id, _digest(primitive.bound_head.canonical_bytes()))
        != (scope.bound_head.revision.head, scope.bound_head.revision.fingerprint)
        or not coordinates
        or any(
            not int(scope.horizon.first_eligible_due_coordinate)
            <= int(coordinate.canonical_coordinate)
            <= int(scope.horizon.last_eligible_due_coordinate)
            for coordinate in coordinates
        )
    ):
        raise LoopRejected("lease root primitive exceeds selected mandate applicability")


def _selected_policy(runtime: R15SchedulerRuntime) -> tuple[PreparedLeasePolicyAdoption, Present]:
    candidates = [
        decision
        for decision in runtime._owner_decisions().snapshot().decisions
        if decision.prepared.request.operation == _POLICY_OPERATION
    ]
    if len(candidates) != 1:
        raise LoopRejected("separate selected lease execution policy is required")
    decision = candidates[0]
    prepared = validate_selected_lease(decision.prepared.request)
    if not isinstance(prepared, PreparedLeasePolicyAdoption):
        raise LoopRejected("selected lease policy type differs")
    return prepared, Present(head=prepared.record_id, fingerprint=prepared.fingerprint)


def _validate_authentication(batch: SingleOwnerBatch, body: dict[str, object]) -> None:
    auth = batch.authentication
    if not isinstance(auth, WorkerAuthentication):
        raise LoopRejected("lease historical worker authentication absent")
    generation = json.loads(
        base64.b64decode(cast(str, body["generation_preimages"]), validate=True)
    )
    authentication = generation["authentication"]
    sent, response = authentication["request"], authentication["response"]
    call_raw = base64.b64decode(sent["canonical_payload_base64"], validate=True)
    call_body = json.loads(call_raw)
    observation = authentication["observation"]
    call = _TrustOwnerCall(
        mode=call_body["mode"],
        request_bytes=base64.b64decode(call_body["request_bytes"], validate=True),
        snapshot_bytes=base64.b64decode(call_body["snapshot_bytes"], validate=True),
    )
    result = _evaluate(call)
    trust = generation["trust_reference"]
    worker = generation["broker_generation_preimage"]["agent_session"]
    proof = auth.invocation
    request = json.loads(call.request_bytes)
    if (
        call.mode != "AUTHENTICATE"
        or call.canonical_bytes() != call_raw
        or call.snapshot_bytes != base64.b64decode(observation["snapshot_base64"], validate=True)
        or sent["operation_id"] != "deployment_trust.authenticate"
        or response["disposition"] != "SUCCESS"
        or response["request_id"] != sent["request_id"]
        or response["responder"] != sent["callee"]
        or sent["callee"]["owner_id"] != "deployment_trust"
        or result.disposition != "VALID"
        or result.reference_bytes is None
        or result.canonical_bytes()
        != base64.b64decode(response["canonical_payload_base64"], validate=True)
        or result.canonical_bytes()
        != base64.b64decode(authentication["result_base64"], validate=True)
        or json.loads(result.reference_bytes) != trust
        or (trust["tenant_id"], trust["principal_id"], trust["contour"], trust["source_head"])
        != ("hermetic-tenant", "hermetic-principal", "CLI", "local")
        or request["session_id"] != "hermetic-session"
        or request["credential_id"] != "hermetic-credential"
        or (
            proof.broker_epoch,
            proof.broker_session,
            proof.runtime_generation,
            proof.operation_subject,
        )
        != (
            str(worker["broker_epoch"]),
            worker["session_id"],
            worker["generation_id"],
            batch.identity.command_id,
        )
        or proof.issuance_fingerprint
        != _digest(
            _canonical(
                [
                    proof.issuance_id,
                    batch.identity.model_dump(mode="json"),
                    batch.command.model_dump(mode="json"),
                    auth.applicability_fingerprint,
                ]
            )
        )
        or batch.complete_batch_fingerprint
        != _digest(
            _canonical(batch.model_dump(mode="json", exclude={"complete_batch_fingerprint"}))
        )
    ):
        raise LoopRejected("lease historical trust IPC or invocation provenance differs")
    if batch.operation == _POLICY_OPERATION:
        prepared = PreparedLeasePolicyAdoption.model_validate_json(_canonical(body["prepared"]))
        record = validate_historical_lease_policy(prepared)
        source = record.source
        if (
            source.trust_request_frame != _canonical(sent)
            or source.trust_response_frame != _canonical(response)
            or source.trust_observation_bytes != _canonical(observation)
            or record.policy.clock_source != _clock_source(record.policy.clock_source.source_id)
        ):
            raise LoopRejected("lease selected policy original trust frames differ")
    else:
        evidence = validate_historical_acquire(
            base64.b64decode(cast(str, body["acquire"]), validate=True)
        )
        execution = {
            "execution_session": _EXECUTION_SESSION,
            "broker_epoch": worker["broker_epoch"],
            "generation": worker["generation_id"],
            "policy": evidence.source.policy.adoption.model_dump(mode="json"),
        }
        if evidence.source.authentication_frames != (
            _canonical(sent),
            _canonical(response),
            _canonical(execution),
        ):
            raise LoopRejected("lease selected execution authentication frames differ")


def validate_selected_lease(
    batch: RegisteredPublication,
) -> PreparedLeasePolicyAdoption | LeaseAcquireEvidence | None:
    if batch.operation not in (_POLICY_OPERATION, "scheduler.acquire"):
        return None
    if (
        not isinstance(batch, SingleOwnerBatch)
        or not isinstance(batch.authentication, WorkerAuthentication)
        or batch.authentication.applicability_schema != _EVIDENCE_SCHEMA
        or _digest(batch.authentication.applicability_bytes)
        != batch.authentication.applicability_fingerprint
    ):
        raise LoopRejected("lease publication evidence differs")
    body = json.loads(batch.authentication.applicability_bytes)
    if _canonical(body) != batch.authentication.applicability_bytes:
        raise LoopRejected("lease publication evidence is not canonical")
    _validate_authentication(batch, body)

    prepared: PreparedLeasePolicyAdoption | LeaseAcquireEvidence
    schema: str
    if batch.operation == _POLICY_OPERATION:
        prepared = PreparedLeasePolicyAdoption.model_validate_json(_canonical(body["prepared"]))
        record = validate_historical_lease_policy(prepared)
        if (
            record.policy.execution_session_id != _EXECUTION_SESSION
            or record.source.administrative_policy
            != Present(
                head="r15-lease-admin-policy-v1:" + _digest(_ADMIN_POLICY_BYTES),
                fingerprint=_digest(_ADMIN_POLICY_BYTES),
            )
        ):
            raise LoopRejected("lease administrative policy differs")
        raw = record.request.canonical_bytes()
        expected_record = OwnerRecordBytes(
            owner="broker_scheduler",
            record_kind="r15.lease-policy-adoption",
            record_id=prepared.record_id,
            schema_id=_POLICY_SCHEMA,
            canonical_bytes=prepared.canonical_record_bytes,
            fingerprint=prepared.fingerprint,
        )
        command_id, schema = prepared.command_id, record.request.schema_id
    else:
        prepared = validate_historical_acquire(
            base64.b64decode(cast(str, body["acquire"]), validate=True)
        )
        policy = PreparedLeasePolicyAdoption.model_validate_json(_canonical(body["policy"]))
        policy_for_execution(
            policy,
            prepared.source.policy.adoption,
            prepared.source.context,
            prepared.source.mandate,
        )
        _validate_root_frames(
            prepared.source.selected_root_frames, prepared.source.current, prepared.source.mandate
        )
        if prepared.request.context.session_id != _EXECUTION_SESSION:
            raise LoopRejected("lease selected execution session differs")
        raw = prepared.request.canonical_bytes()
        row = prepared.prepared
        expected_record = OwnerRecordBytes(
            owner="agent_loop",
            record_kind=row.record_kind,
            record_id=row.record_id,
            schema_id=row.schema_id,
            canonical_bytes=row.canonical_record_bytes,
            fingerprint=row.fingerprint,
        )
        if prepared.request.snapshot.issued is None:
            raise LoopRejected("lease selected clock issuance missing")
        command_id, schema = (
            prepared.request.snapshot.issued.proof.command_id,
            "chiplog.scheduler.lease-preparation.v1",
        )
        sent, response = body["owner_request"], body["owner_response"]
        if (
            sent["operation_id"] != "scheduler.prepare_lease"
            or response["request_id"] != sent["request_id"]
            or response["responder"] != sent["callee"]
            or base64.b64decode(response["canonical_payload_base64"], validate=True)
            != row.canonical_bytes()
            or base64.b64decode(sent["canonical_payload_base64"], validate=True) != raw
        ):
            raise LoopRejected("lease exact owner frames differ")
    if (
        batch.command.canonical_bytes != raw
        or batch.command.schema_id != schema
        or batch.command.fingerprint != _digest(raw)
        or batch.identity.command_id != command_id
        or batch.complete_records != (expected_record,)
    ):
        raise LoopRejected("lease selected command or exact output differs")
    return prepared


def validate_selected_lease_decision(
    decision: SelectedOwnerDecision, decisions: tuple[SelectedOwnerDecision, ...]
) -> None:
    prepared = validate_selected_lease(decision.prepared.request)
    if prepared is None:
        return
    earlier = tuple(
        item for item in decisions if item.tenant_commit_sequence < decision.tenant_commit_sequence
    )
    if isinstance(prepared, PreparedLeasePolicyAdoption):
        record = validate_historical_lease_policy(prepared)
        mandate = record.source.mandate
        if (
            record.source.cut.tenant_frontier != decision.prepared.request.expected.tenant_frontier
            or record.source.cut.materialization_commitment
            != decision.prepared.predecessor_commitment
            or record.source.authority_head
            != Present(
                head=decision.prepared.request.expected.registry_head,
                fingerprint=decision.prepared.request.expected.registry_fingerprint,
            )
        ):
            raise LoopRejected("selected lease policy source cut differs from selected predecessor")
    else:
        authentication = decision.prepared.request.authentication
        if not isinstance(authentication, WorkerAuthentication):
            raise LoopRejected("lease selected invocation type differs")
        evidence = json.loads(authentication.applicability_bytes)
        policy = PreparedLeasePolicyAdoption.model_validate_json(_canonical(evidence["policy"]))
        matches = [
            item
            for item in earlier
            if item.prepared.request.operation == _POLICY_OPERATION
            and validate_selected_lease(item.prepared.request) == policy
        ]
        if len(matches) != 1:
            raise LoopRejected("lease embedded policy has no exact preceding selected adoption")
        mandate = prepared.source.mandate
        for raw in prepared.source.selected_root_frames:
            matches = [
                item
                for item in earlier
                if item.prepared.request.operation == "scheduler.decide_interval"
                and _canonical(item.prepared.request.model_dump(mode="json")) == raw
            ]
            if len(matches) != 1:
                raise LoopRejected("lease root frame has no exact preceding selected tick")
    matches = [
        item
        for item in earlier
        if item.prepared.request.operation == "scheduler.issue_mandate"
        and Present(head=item.decision_head, fingerprint=item.decision_fingerprint)
        == mandate.issuance_observation.revision
        and any(
            row.record_id == mandate.mandate_head.head
            and row.fingerprint == mandate.mandate_head.fingerprint
            and row.canonical_bytes == mandate.canonical_mandate_bytes
            for row in item.prepared.request.complete_records
        )
    ]
    if len(matches) != 1:
        raise LoopRejected("lease mandate has no exact preceding selected issuance")


class _Authority(SchedulerPublicationAuthority):
    _runtime: R15SchedulerRuntime
    _operations: tuple[BrokerOperation]

    def __init__(
        self,
        runtime: R15SchedulerRuntime,
        observed: ObservedTrustCall,
        operation: BrokerOperation,
        command_id: str,
        handle: LeaseExecutionSession | None = None,
    ) -> None:
        super().__init__(
            runtime,
            observed,
            SchedulerConfigurationAdoption(adoption_act_id=command_id, command_bytes=b"lease"),
        )
        self._operations = (operation,)
        self._command_id = command_id
        self._handle = handle
        self._originals: list[tuple[PublicationIdentity, OwnerCommandBytes]] = []
        self._recheck: Callable[[], None] | None = None
        self._evidence_fingerprints: dict[str, str] = {}
        self._clock = runtime._tick_clock

    def _check_handle(self) -> None:
        if self._handle is None:
            return
        handle = self._handle
        session = capture_generation_sources(self._runtime, self._observed).agent_session
        if not any(item is handle for item in self._runtime._lease_execution_sessions) or (
            handle.service_identity,
            handle.session_id,
            handle.broker_epoch,
            handle.generation,
        ) != (EXECUTION_SERVICE, _EXECUTION_SESSION, session.broker_epoch, session.generation_id):
            raise LoopRejected("unknown or stale private execution session")
        _, reference = _selected_policy(self._runtime)
        if reference != handle.policy:
            raise LoopRejected("execution session selected policy changed")

    def capture_fresh(self) -> SchedulerFreshSources:
        if self._runtime._tick_clock is not self._clock:
            raise LoopRejected("lease registered clock instance changed")
        self._check_handle()
        return super().capture_fresh()

    def issue_invocation(
        self, identity: PublicationIdentity, command: OwnerCommandBytes
    ) -> InvocationProofRef:
        self._check_handle()
        if (identity, command) not in self._originals:
            raise LoopRejected("lease original not privately retained")
        session = capture_generation_sources(self._runtime, self._observed).agent_session
        nonce = secrets.token_hex(32)
        proof = InvocationProofRef(
            issuance_id=nonce,
            issuance_fingerprint=_digest(
                _canonical(
                    [
                        nonce,
                        identity.model_dump(mode="json"),
                        command.model_dump(mode="json"),
                        self._evidence_fingerprints[command.fingerprint],
                    ]
                )
            ),
            broker_epoch=str(session.broker_epoch),
            broker_session=session.session_id,
            runtime_generation=session.generation_id,
            operation_subject=identity.command_id,
        )
        self._invocations[nonce] = (proof, identity, command, self._operations[0])
        return proof

    def authenticate_replay(self, query: ExactReplayQuery) -> PublicationRejected | None:
        try:
            self._check_handle()
        except (ValueError, LoopRejected) as error:
            return self._rejected(query.identity, "DENIED", str(error))
        return super().authenticate_replay(query)

    def _matches_original(self, request: SingleOwnerBatch) -> bool:
        return validate_selected_lease(request) is not None

    def check_prepared(
        self, prepared: PreparedOwnerPublication
    ) -> Literal["DENIED", "STALE", "INDETERMINATE"] | None:
        result = super().check_prepared(prepared)
        if result is not None:
            return result
        try:
            if self._recheck is None:
                return "DENIED"
            self._recheck()
            return None
        except ValueError, LoopRejected:
            return "STALE"


class _SelectingJournal:
    """Recheck private issuance at the durable selection linearization point."""

    def __init__(self, journal: OwnerDecisionJournal, authority: _Authority) -> None:
        self._journal, self._authority = journal, authority

    def lookup(self, tenant_id: str, command_id: str) -> SelectedOwnerDecision | None:
        return self._journal.lookup(tenant_id, command_id)

    def select(
        self, prepared: PreparedOwnerPublication, resulting_commitment: str
    ) -> SelectedOwnerDecision:
        refusal = self._authority.check_prepared(prepared)
        if refusal is not None:
            raise LoopRejected(
                "lease selected source or clock changed before durable selection: " + refusal
            )
        return self._journal.select(prepared, resulting_commitment)

    def materialized(self, decision: SelectedOwnerDecision) -> None:
        self._journal.materialized(decision)


class _AdminPort:
    def __init__(self, authority: _Authority) -> None:
        self.authority = authority

    def capture(self, peer: str, request: LeasePolicyAdoptionRequest) -> LeasePolicyAdminSource:
        if peer != "hermetic-ingress":
            raise LoopRejected("lease policy administrator ingress differs")
        sources = self.authority.capture_fresh()
        observation = self.authority._observed
        document = LeasePolicyDocument.model_validate_json(request.policy_bytes)
        generation = json.loads(sources.generations.evidence_bytes)
        return LeasePolicyAdminSource(
            principal_id=generation["trust_reference"]["principal_id"],
            admin_session_id="hermetic-session",
            administrative_policy=Present(
                head="r15-lease-admin-policy-v1:" + _digest(_ADMIN_POLICY_BYTES),
                fingerprint=_digest(_ADMIN_POLICY_BYTES),
            ),
            authority_head=sources.startup.registration.reference,
            trust_observation_bytes=_canonical(generation["authentication"]["observation"]),
            trust_request_frame=_canonical(_frame(observation.request)),
            trust_response_frame=_canonical(_frame(observation.response)),
            request_fingerprint=_digest(request.canonical_bytes()),
            mandate=_mandate(sources, document.selected_mandate),
            revocation=Absent(),
            cut=_cut(sources),
        )


class _AcquirePort:
    def __init__(self, authority: _Authority, handle: LeaseExecutionSession) -> None:
        self.authority, self.handle = authority, handle

    def capture(self, peer: str, root_id: str) -> LeaseAcquireSource:
        if peer != self.handle.session_id:
            raise LoopRejected("lease execution peer differs")
        sources = self.authority.capture_fresh()
        prepared, ref = _selected_policy(self.authority._runtime)
        record = validate_historical_lease_policy(prepared)
        mandate = _mandate(sources, record.policy.selected_mandate)
        context = SchedulerContextRef(
            tenant_id="hermetic-tenant",
            service_identity=EXECUTION_SERVICE,
            session_id=self.handle.session_id,
            mandate_head=mandate.mandate_head.head,
            issuance_id="r15-selected-lease-policy:" + ref.fingerprint,
            issuance_fingerprint=ref.fingerprint,
        )
        current = next(
            (item for item in sources.startup.index.lineages if item.lineage.root_id == root_id),
            None,
        )
        if current is None:
            raise LoopRejected("lease requires selected tick-created root")
        scope = mandate.mandate.scope
        selected_schedule = sources.startup.index.schedules[0]
        selected_missed_policy = sources.startup.index.policies[0]
        schedule_ref, missed_ref = (
            schedule_head(selected_schedule),
            policy_head(selected_missed_policy),
        )
        if (
            current.lineage.schedule_id != scope.schedule_head.subject_id
            or current.lineage.schedule_revision != schedule_ref.schedule_revision
            or current.lineage.policy_revision != missed_ref.policy_revision
            or (schedule_ref.head, schedule_ref.fingerprint)
            != (scope.schedule_head.revision.head, scope.schedule_head.revision.fingerprint)
            or (missed_ref.head, missed_ref.fingerprint)
            != (
                scope.missed_policy_head.revision.head,
                scope.missed_policy_head.revision.fingerprint,
            )
        ):
            raise LoopRejected("lease root differs from selected mandate schedule/policy")

        root_frames = tuple(
            _canonical(original.selection.prepared.request.model_dump(mode="json"))
            for original in sources.startup.cut.historical_requests
            if original.selection.prepared.request.operation == "scheduler.decide_interval"
            and any(
                root_id.encode() in row.canonical_bytes
                for row in original.selection.prepared.request.complete_records
            )
        )
        if not root_frames:
            raise LoopRejected("lease root has no selected tick provenance")
        _validate_root_frames(root_frames, current, mandate)

        # This route supports first ACQUIRE only. Any earlier lease ID for this
        # root makes the current state non-UNLEASED and therefore denies.
        used = tuple(
            json.loads(row.canonical_bytes)["command"]["proposed_lease_id"]
            for original in sources.startup.cut.historical_requests
            if original.selection.prepared.request.operation
            in ("scheduler.acquire", "scheduler.renew", "scheduler.takeover")
            for row in original.selection.prepared.request.complete_records
            if json.loads(row.canonical_bytes)["previous"]["lineage"]["root_id"] == root_id
        )
        policy = policy_for_execution(prepared, ref, context, mandate)
        return LeaseAcquireSource(
            context=context,
            policy=policy,
            mandate=mandate,
            revocation=Absent(),
            cut=_cut(sources),
            current=current,
            registry=sources.startup.registration.reference,
            used_lease_ids=tuple(dict.fromkeys(used)),
            authentication_frames=(
                _canonical(_frame(self.authority._observed.request)),
                _canonical(_frame(self.authority._observed.response)),
                _canonical(
                    {
                        "execution_session": self.handle.session_id,
                        "broker_epoch": self.handle.broker_epoch,
                        "generation": self.handle.generation,
                        "policy": ref.model_dump(mode="json"),
                    }
                ),
            ),
            selected_root_frames=root_frames,
        )


def _manifest(sources: SchedulerFreshSources) -> AuthoritativeReadManifest:
    cut, registry = sources.startup.cut, sources.startup.registration.reference
    values = dict(
        tenant_id=cut.tenant_id,
        tenant_frontier=cut.tenant_frontier,
        expected_materialization_commitment=cut.materialization_commitment,
        registry_head=registry.head,
        registry_fingerprint=registry.fingerprint,
        ordered_heads=[],
    )
    return AuthoritativeReadManifest(
        tenant_id=cut.tenant_id,
        tenant_frontier=cut.tenant_frontier,
        expected_materialization_commitment=cut.materialization_commitment,
        registry_head=registry.head,
        registry_fingerprint=registry.fingerprint,
        ordered_heads=(),
        complete_manifest_fingerprint=_digest(_canonical(values)),
    )


async def _publish(
    runtime: R15SchedulerRuntime,
    authority: _Authority,
    raw: bytes,
    schema: str,
    record: OwnerRecordBytes,
    body: Mapping[str, object],
    sources: SchedulerFreshSources,
) -> BrokerPublicationResult:
    identity = PublicationIdentity(
        tenant_id=runtime._tenant_id,
        command_id=authority._command_id,
        command_fingerprint=_digest(raw),
        canonicalization_version="chiplog.owner-publication.v1",
    )
    command = OwnerCommandBytes(
        owner="agent_loop"
        if authority._operations == ("scheduler.acquire",)
        else "broker_scheduler",
        schema_id=schema,
        canonical_bytes=raw,
        fingerprint=_digest(raw),
    )
    authority._originals.append((identity, command))
    body = {
        **body,
        "generation_preimages": base64.b64encode(sources.generations.evidence_bytes).decode(),
    }
    evidence = _canonical(body)
    authority._evidence_fingerprints[command.fingerprint] = _digest(evidence)
    authentication = WorkerAuthentication(
        invocation=authority.issue_invocation(identity, command),
        applicability_schema=_EVIDENCE_SCHEMA,
        applicability_bytes=evidence,
        applicability_fingerprint=_digest(evidence),
    )
    expected = _manifest(sources)
    values = dict(
        kind="SINGLE_OWNER",
        operation=authority._operations[0],
        identity=identity.model_dump(mode="json"),
        authentication=authentication.model_dump(mode="json"),
        expected=expected.model_dump(mode="json"),
        command=command.model_dump(mode="json"),
        complete_records=[record.model_dump(mode="json")],
    )
    batch = SingleOwnerBatch(
        operation=authority._operations[0],
        identity=identity,
        authentication=authentication,
        expected=expected,
        command=command,
        complete_records=(record,),
        complete_batch_fingerprint=_digest(_canonical(values)),
    )
    validate_selected_lease(batch)
    authority.register_prepared(batch, sources)
    return await BrokerPublicationCoordinator(
        runtime._appender, authority, _SelectingJournal(runtime._owner_decisions(), authority)
    ).commit(batch)


async def _replay(
    runtime: R15SchedulerRuntime, authority: _Authority, requested: bytes | dict[str, object]
) -> BrokerPublicationResult | None:
    coordinator = BrokerPublicationCoordinator(
        runtime._appender, authority, runtime._owner_decisions()
    )
    with runtime._authority_gate().hold():
        authority._check_handle()
        capture_generation_sources(runtime, authority._observed)
        selected = runtime._owner_decisions().lookup(runtime._tenant_id, authority._command_id)
        if selected is None:
            return None
        original = selected.prepared.request
        if not isinstance(original, SingleOwnerBatch) or not isinstance(
            original.authentication, WorkerAuthentication
        ):
            raise LoopRejected("selected lease envelope differs")
        validate_selected_lease(original)
        body = json.loads(original.authentication.applicability_bytes)
        exact = (
            (original.command.canonical_bytes == requested)
            if authority._handle is None
            else body["intent"] == requested
        )
        if not exact:
            return PublicationRejected(
                kind="CONFLICT",
                tenant_id=runtime._tenant_id,
                command_id=authority._command_id,
                reason="changed exact lease command",
            )
        authority._originals.append((original.identity, original.command))
        authority._evidence_fingerprints[original.command.fingerprint] = (
            original.authentication.applicability_fingerprint
        )
        proof = authority.issue_invocation(original.identity, original.command)
        result = coordinator.lookup_exact(
            ExactReplayQuery(
                identity=original.identity,
                operation=original.operation,
                current_invocation=proof,
                original_commands=(original.command,),
            )
        )
        if isinstance(result, JournalSelectedPublication):
            return result
        if not isinstance(result, PublicationRejected):
            raise LoopRejected("selected lease has no exact replay")
        if result.kind != "HOLD" or authority.materialization_state(selected) != "ABSENT":
            return result
    return await coordinator.recover_selected(runtime._tenant_id, authority._command_id)


async def _authenticate_lease_admin(runtime: R15SchedulerRuntime, peer: str) -> ObservedTrustCall:
    if peer != "hermetic-ingress":
        raise LoopRejected("lease policy requires authenticated hermetic administrator")
    observation = runtime._trust.capture_verified_observation()
    request = runtime._trust_call_request(
        "AUTHENTICATE",
        {
            "contour": "CLI",
            "credential_id": "hermetic-credential",
            "peer_credential": f"uid:{os.getuid()}",
            "session_id": "hermetic-session",
        },
        snapshot_bytes=observation.snapshot_bytes,
    )
    # Bound is part of the closed lease profile and actual transmitted request.
    # Existing CLI custody and generic trust call budgets retain their own bounds.
    request = request.model_copy(
        update={
            "budget": request.budget.model_copy(
                update={"absolute_deadline_ns": time.monotonic_ns() + 30_000_000_000}
            )
        }
    )
    response = await runtime._supervisor.runtime().call(request)
    if (
        isinstance(response, PublicPortRejected)
        or response.request_id != request.request_id
        or response.responder != request.callee
        or response.schema_id != "chiplog.deployment-trust.owner-result.v1"
    ):
        raise LoopRejected("lease administrator authentication IPC rejected")
    observed = ObservedTrustCall(
        observation, request, response, runtime._decode_trust_result(response.canonical_payload)
    )
    capture_generation_sources(runtime, observed)
    return observed


async def adopt_lease_policy(
    runtime: R15SchedulerRuntime, peer: str, request: LeasePolicyAdoptionRequest
) -> BrokerPublicationResult:
    request = LeasePolicyAdoptionRequest.model_validate_json(request.canonical_bytes())
    observed = await _authenticate_lease_admin(runtime, peer)
    authority = _Authority(
        runtime, observed, _POLICY_OPERATION, "r15-lease-policy-adopt:" + request.adoption_act_id
    )
    replay = await _replay(runtime, authority, request.canonical_bytes())
    if replay is not None:
        return replay
    if any(
        item.prepared.request.operation == _POLICY_OPERATION
        for item in runtime._owner_decisions().snapshot().decisions
    ):
        raise LoopRejected("lease execution policy already selected")
    issuer = LeasePolicyAdoptionIssuer(runtime._tick_clock, _AdminPort(authority))
    prepared = issuer.prepare(peer, request)
    authority._recheck = lambda: issuer.recheck(prepared)
    sources = authority.capture_fresh()
    row = OwnerRecordBytes(
        owner="broker_scheduler",
        record_kind="r15.lease-policy-adoption",
        record_id=prepared.record_id,
        schema_id=_POLICY_SCHEMA,
        canonical_bytes=prepared.canonical_record_bytes,
        fingerprint=prepared.fingerprint,
    )
    return await _publish(
        runtime,
        authority,
        request.canonical_bytes(),
        request.schema_id,
        row,
        {"prepared": prepared.model_dump(mode="json")},
        sources,
    )


async def open_execution_session(runtime: R15SchedulerRuntime, peer: str) -> LeaseExecutionSession:
    observed = await _authenticate_lease_admin(runtime, peer)
    with runtime._authority_gate().hold():
        authority = _Authority(runtime, observed, _POLICY_OPERATION, "open-session")
        sources = authority.capture_fresh()
        policy, reference = _selected_policy(runtime)
        record = validate_historical_lease_policy(policy)
        _mandate(sources, record.policy.selected_mandate)
        session = sources.generations.agent_session
        handle = LeaseExecutionSession(
            EXECUTION_SERVICE,
            _EXECUTION_SESSION,
            reference,
            session.broker_epoch,
            session.generation_id,
        )
        runtime._lease_execution_sessions.append(handle)
        return handle


async def acquire(
    runtime: R15SchedulerRuntime,
    handle: LeaseExecutionSession,
    root_id: str,
    command_id: str,
    duration_ns: int = 60_000_000_000,
) -> BrokerPublicationResult:
    if not any(item is handle for item in runtime._lease_execution_sessions):
        raise LoopRejected("unknown private execution session")
    # Current administrator trust is independently reauthenticated; the caller's
    # execution authority additionally requires the private selected handle.
    observed = await _authenticate_lease_admin(runtime, "hermetic-ingress")
    authority = _Authority(runtime, observed, "scheduler.acquire", command_id, handle)
    intent = {
        "root_id": root_id,
        "command_id": command_id,
        "duration_ns": duration_ns,
        "service": handle.service_identity,
        "session": handle.session_id,
        "policy": handle.policy.model_dump(mode="json"),
    }
    replay = await _replay(runtime, authority, intent)
    if replay is not None:
        return replay
    issuer = LeaseAcquireIssuer(runtime._tick_clock, _AcquirePort(authority, handle))
    evidence = issuer.prepare(handle.session_id, root_id, command_id, duration_ns)
    authority._recheck = lambda: issuer.recheck(evidence)
    sources = authority.capture_fresh()
    session = sources.generations.agent_session
    sent = PublicPortCall(
        operation_id="scheduler.prepare_lease",
        request_id="lease:" + evidence.nonce,
        caller=BrokerSession(
            tenant_id=runtime._tenant_id,
            broker_epoch=session.broker_epoch,
            generation_id=session.generation_id,
            owner_id="broker",
            session_id="broker:" + session.generation_id,
        ),
        callee=session,
        schema_id="chiplog.scheduler.lease-preparation.v1",
        canonical_payload=evidence.request.canonical_bytes(),
        budget=CallBudget(
            remaining_calls=1,
            remaining_depth=1,
            policy_version=1,
            absolute_deadline_ns=observed.request.budget.absolute_deadline_ns,
        ),
    )
    response = await runtime._supervisor.runtime().call(sent)
    with runtime._authority_gate().hold():
        issuer.recheck(evidence)
        if (
            isinstance(response, PublicPortRejected)
            or response.request_id != sent.request_id
            or response.responder != sent.callee
            or response.schema_id != "chiplog.scheduler.prepared-lease.v1"
            or response.canonical_payload != evidence.prepared.canonical_bytes()
        ):
            raise LoopRejected("lease owner response differs")
        prepared_policy, _ = _selected_policy(runtime)
        row = evidence.prepared
        record = OwnerRecordBytes(
            owner="agent_loop",
            record_kind=row.record_kind,
            record_id=row.record_id,
            schema_id=row.schema_id,
            canonical_bytes=row.canonical_record_bytes,
            fingerprint=row.fingerprint,
        )
        body = {
            "acquire": base64.b64encode(evidence.canonical_bytes()).decode(),
            "policy": prepared_policy.model_dump(mode="json"),
            "intent": intent,
            "owner_request": _frame(sent),
            "owner_response": _frame(response),
        }
    return await _publish(
        runtime,
        authority,
        evidence.request.canonical_bytes(),
        "chiplog.scheduler.lease-preparation.v1",
        record,
        body,
        sources,
    )
