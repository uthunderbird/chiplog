{
  "CurrentHermeticExecutionScopeResultV1": {
    "$defs": {
      "CurrentHermeticExecutionScopeV1": {
        "additionalProperties": false,
        "description": "Untrusted observation until authenticated by the owner at the consuming fence.",
        "properties": {
          "disposition": {
            "const": "CURRENT",
            "title": "Disposition",
            "type": "string"
          },
          "ordered_current_source_refs": {
            "items": {
              "$ref": "#/$defs/ExactHead"
            },
            "minItems": 1,
            "title": "Ordered Current Source Refs",
            "type": "array"
          },
          "scope_ref": {
            "$ref": "#/$defs/ExactHead"
          },
          "selector_generation": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "title": "Selector Generation",
            "type": "integer"
          },
          "source_anchor": {
            "$ref": "#/$defs/HermeticOutputScopeAnchorV1"
          }
        },
        "required": [
          "disposition",
          "scope_ref",
          "source_anchor",
          "selector_generation",
          "ordered_current_source_refs"
        ],
        "title": "CurrentHermeticExecutionScopeV1",
        "type": "object"
      },
      "ExactHead": {
        "additionalProperties": false,
        "properties": {
          "fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Fingerprint",
            "type": "string"
          },
          "head": {
            "minLength": 1,
            "title": "Head",
            "type": "string"
          },
          "identity": {
            "minLength": 1,
            "title": "Identity",
            "type": "string"
          }
        },
        "required": [
          "identity",
          "head",
          "fingerprint"
        ],
        "title": "ExactHead",
        "type": "object"
      },
      "HermeticOutputScopeAnchorV1": {
        "additionalProperties": false,
        "description": "Locator for trust_records(decision_id, ordinal), not main records.record_id.\n\nDecision fingerprint hashes journal envelope bytes; record fingerprint hashes\nthe full materialized record envelope, not merely its nested scope payload.\nOwner validation resolves both byte strings and checks revision/predecessor.",
        "properties": {
          "decision": {
            "$ref": "#/$defs/ExactHead"
          },
          "owner_id": {
            "const": "deployment_trust",
            "title": "Owner Id",
            "type": "string"
          },
          "predecessor": {
            "anyOf": [
              {
                "$ref": "#/$defs/ExactHead"
              },
              {
                "type": "null"
              }
            ]
          },
          "record": {
            "$ref": "#/$defs/ExactHead"
          },
          "record_ordinal": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "title": "Record Ordinal",
            "type": "integer"
          },
          "record_type_id": {
            "const": "chiplog.deployment_trust.hermetic_output_scope",
            "title": "Record Type Id",
            "type": "string"
          },
          "schema_id": {
            "const": "chiplog.deployment_trust.record.v1",
            "title": "Schema Id",
            "type": "string"
          },
          "scope_revision": {
            "maximum": 18446744073709551615,
            "minimum": 0,
            "title": "Scope Revision",
            "type": "integer"
          },
          "selected_resource_observation_ref": {
            "$ref": "#/$defs/SelectedHermeticResourceObservationRefV1"
          }
        },
        "required": [
          "owner_id",
          "decision",
          "record_ordinal",
          "record_type_id",
          "schema_id",
          "record",
          "scope_revision",
          "predecessor",
          "selected_resource_observation_ref"
        ],
        "title": "HermeticOutputScopeAnchorV1",
        "type": "object"
      },
      "NonCurrentHermeticExecutionScopeV1": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "enum": [
              "STALE",
              "UNSUPPORTED",
              "DENIED"
            ],
            "title": "Disposition",
            "type": "string"
          }
        },
        "required": [
          "disposition"
        ],
        "title": "NonCurrentHermeticExecutionScopeV1",
        "type": "object"
      },
      "SelectedHermeticResourceObservationRefV1": {
        "additionalProperties": false,
        "description": "Locator for the selected R16 observation in retained inbox initialization.\n\nFingerprint is SHA256 of canonical JSON [grant.hex(), credential.hex(),\nendpoint.hex(), clock_epoch, signature], using UTF-8, ensure_ascii=False and\nseparators=(',', ':'). It binds exact bytes, not their authenticity. The\nregistered reader must authenticate selection and R16 historical/current\nsignatures under the shared gate. No dispatch grant becomes a disclosure or\nSEND permit by inclusion here.",
        "properties": {
          "selected_initialization": {
            "$ref": "#/$defs/ExactHead"
          },
          "signature_domain": {
            "const": "dispatch-resources.v1",
            "title": "Signature Domain",
            "type": "string"
          },
          "signed_observation_fingerprint": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Signed Observation Fingerprint",
            "type": "string"
          }
        },
        "required": [
          "signature_domain",
          "selected_initialization",
          "signed_observation_fingerprint"
        ],
        "title": "SelectedHermeticResourceObservationRefV1",
        "type": "object"
      }
    },
    "discriminator": {
      "mapping": {
        "CURRENT": "#/$defs/CurrentHermeticExecutionScopeV1",
        "DENIED": "#/$defs/NonCurrentHermeticExecutionScopeV1",
        "STALE": "#/$defs/NonCurrentHermeticExecutionScopeV1",
        "UNSUPPORTED": "#/$defs/NonCurrentHermeticExecutionScopeV1"
      },
      "propertyName": "disposition"
    },
    "oneOf": [
      {
        "$ref": "#/$defs/CurrentHermeticExecutionScopeV1"
      },
      {
        "$ref": "#/$defs/NonCurrentHermeticExecutionScopeV1"
      }
    ]
  },
